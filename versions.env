# Single source of truth for the PostgreSQL versions this extension targets.
# Sourced by build.sh and test.sh; mirrored by the pg* features in Cargo.toml
# and by the matrix in .github/workflows/rust.yml.

# Latest stable major. The image tag floats to the newest 18.x, matching the
# `postgresql-18` package the .deb is built against.
PG_STABLE=18
PG_STABLE_IMAGE=postgres:18-trixie

# Latest beta. PGDG's -testing suite carries a newer beta than pgrx' own
# vendored download, so both Dockerfiles pull it from there.
PG_BETA=19
PG_BETA_IMAGE=postgres:19beta3-trixie

# PostGIS only publishes 19beta1, which is older than the beta above, so the
# PostGIS variant is built for the stable major only.
POSTGIS_IMAGE=postgis/postgis:18-3.6
POSTGIS_TAG=18-3.6

PGRX_VERSION=0.19.2
DEBIAN_CODENAME=trixie

IMAGE_POSTGRES=larsw/postgres-accumulo-access
IMAGE_POSTGIS=larsw/postgis-accumulo-access
IMAGE_TOOLCHAIN=accumulo-access-pg-test
