# Single source of truth for the PostgreSQL versions this extension targets.
#
# Sourced by build.sh and test.sh, and read by the GitHub workflows (which
# extract the KEY=VALUE lines), so a new major is added here and nowhere else.
# The pg* features in Cargo.toml have to cover every major listed.

# Every major a package is built for, oldest first.
PG_MAJORS="15 16 17 18 19"

# The major `default = ["pg18"]` in Cargo.toml selects, and the one the
# `latest` image tags follow.
PG_DEFAULT=18

# Majors still in beta. Their packages come from PGDG's -testing suite, which
# carries a newer beta than pgrx' own vendored source download.
PG_BETA_MAJORS="19"

# Base image per major, used for the runtime images and the end-to-end suite.
# The stable tags float to the newest minor, matching the postgresql-NN
# packages the .debs are built against.
PG_IMAGE_15=postgres:15-trixie
PG_IMAGE_16=postgres:16-trixie
PG_IMAGE_17=postgres:17-trixie
PG_IMAGE_18=postgres:18-trixie
PG_IMAGE_19=postgres:19beta3-trixie

# PostGIS variant. Built for PG_DEFAULT only: the extension is the same .deb on
# every base, so the extra majors would only re-test PostGIS' own packaging.
# There is deliberately no 19 here -- postgis/postgis still publishes 19beta1,
# which is older than the beta above, so a package built against the current
# beta has no matching PostGIS base to install into.
POSTGIS_IMAGE_18=postgis/postgis:18-3.6

PGRX_VERSION=0.19.2
DEBIAN_CODENAME=trixie

IMAGE_POSTGRES=larsw/postgres-accumulo-access
IMAGE_POSTGIS=larsw/postgis-accumulo-access
IMAGE_TOOLCHAIN=accumulo-access-pg-test
