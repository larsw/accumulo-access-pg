# syntax=docker/dockerfile:1
#
# Toolchain image for building and integration-testing accumulo_access_pg.
#
# It installs every PostgreSQL major the extension targets, straight from PGDG,
# and registers each with pgrx, so `cargo pgrx test pg15` .. `cargo pgrx test
# pg19` all run against real server builds. Stable majors come from the -pgdg
# suite; betas come from -pgdg-testing, which carries a newer beta than pgrx'
# own vendored source download.
FROM debian:trixie-slim

ARG PGRX_VERSION=0.19.2
# Space-separated, and betas must also be listed in PG_BETA_MAJORS.
ARG PG_MAJORS="15 16 17 18 19"
ARG PG_BETA_MAJORS="19"
ARG USER=pgrx
ARG UID=1000
ARG GID=1000

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl wget gnupg git \
      build-essential gcc make pkg-config \
      clang libclang-dev \
      libssl-dev zlib1g-dev liblz4-dev libzstd-dev libreadline-dev libicu-dev \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u ${UID} ${USER}

# Rust and cargo-pgrx first: these are the expensive layers and they don't
# depend on which Postgres majors we go on to install.
USER ${UID}:${GID}
WORKDIR /home/${USER}
ENV PATH="/home/${USER}/.cargo/bin:${PATH}" \
    CARGO_TARGET_DIR="/home/${USER}/target"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain stable --profile minimal
RUN cargo install cargo-pgrx --version ${PGRX_VERSION} --locked

USER root

# Don't let the postgresql-common maintainer scripts spin up clusters we never use.
RUN install -d /etc/postgresql-common \
    && echo "create_main_cluster = false" > /etc/postgresql-common/createcluster.conf

# A beta's client wants a newer libpq5 than the stable suite ships, and the two
# can't coexist. The newer libpq also satisfies the stable clients, so pin the
# shared libpq packages to the -testing suite whenever a beta is in the mix.
RUN set -eux; \
    install -d /usr/share/postgresql-common/pgdg; \
    curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
      -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc; \
    key=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc; \
    echo "deb [signed-by=$key] http://apt.postgresql.org/pub/repos/apt trixie-pgdg main" \
      > /etc/apt/sources.list.d/pgdg.list; \
    if [ -n "${PG_BETA_MAJORS}" ]; then \
      : > /etc/apt/sources.list.d/pgdg-testing.list; \
      for major in ${PG_BETA_MAJORS}; do \
        echo "deb [signed-by=$key] http://apt.postgresql.org/pub/repos/apt trixie-pgdg-testing $major" \
          >> /etc/apt/sources.list.d/pgdg-testing.list; \
      done; \
      printf 'Package: libpq5 libpq-dev libpq-oauth\nPin: release n=trixie-pgdg-testing\nPin-Priority: 1001\n' \
        > /etc/apt/preferences.d/pgdg-libpq; \
    fi; \
    packages=""; \
    for major in ${PG_MAJORS}; do \
      packages="$packages postgresql-$major postgresql-server-dev-$major"; \
    done; \
    apt-get update; \
    apt-get install -y --no-install-recommends $packages; \
    rm -rf /var/lib/apt/lists/*

# `cargo pgrx test` installs the extension into each server's own lib and
# extension directories, so they have to be writable by the build user.
RUN for major in ${PG_MAJORS}; do \
      chown -R ${UID}:${GID} \
        /usr/lib/postgresql/$major/lib \
        /usr/share/postgresql/$major/extension ; \
    done

USER ${UID}:${GID}
RUN set -eux; \
    args=""; \
    for major in ${PG_MAJORS}; do \
      args="$args --pg$major=/usr/lib/postgresql/$major/bin/pg_config"; \
    done; \
    cargo pgrx init $args

# pgrx-tests reads $USER to pick the role it connects to the test cluster as,
# and a numeric `USER` directive leaves it unset. Declared last so it doesn't
# invalidate the toolchain layers above.
ENV USER=${USER}

WORKDIR /work
